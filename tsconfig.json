{
  // This file is not used in compilation. It is here just for a nice editor experience.
  //
  // NOTE: We intentionally do not `extend` "@docusaurus/tsconfig" (3.10.2).
  // That base config sets `baseUrl`, which TypeScript 6 reports as deprecated
  // (TS5101) and TypeScript 7 removes entirely. An inherited option cannot be
  // unset by a child config, so the options below mirror the upstream base
  // config with `baseUrl` dropped. `paths` works without `baseUrl` since
  // TS 4.1 and resolves relative to this file, so `@site/*` behaves identically.
  // Once Docusaurus ships a baseUrl-free tsconfig, this can go back to a plain
  // `"extends": "@docusaurus/tsconfig"`.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "include": ["src/", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": [".docusaurus/", "build/", "node_modules/"]
}
